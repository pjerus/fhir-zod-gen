{
  "name": "Meta",
  "type": "Meta",
  "kind": "complex-type",
  "class": "complex-type",
  "url": "http://hl7.org/fhir/StructureDefinition/Meta",
  "version": "4.0.1",
  "description": "Base StructureDefinition for Meta Type: The metadata about a resource. This is content in the resource that is maintained by the infrastructure. Changes to the content might not always be associated with version changes to the resource.",
  "derivation": "specialization",
  "base": "http://hl7.org/fhir/StructureDefinition/Element",
  "elements": {
    "versionId": {
      "short": "Version specific identifier",
      "type": "id",
      "isSummary": true,
      "index": 0
    },
    "lastUpdated": {
      "short": "When the resource version last changed",
      "type": "instant",
      "isSummary": true,
      "index": 1
    },
    "source": {
      "short": "Identifies where the resource comes from",
      "type": "uri",
      "isSummary": true,
      "index": 2
    },
    "profile": {
      "short": "Profiles this resource claims to conform to",
      "type": "canonical",
      "isSummary": true,
      "array": true,
      "index": 3
    },
    "security": {
      "short": "Security Labels applied to this resource",
      "type": "Coding",
      "isSummary": true,
      "binding": {
        "strength": "extensible",
        "valueSet": "http://hl7.org/fhir/ValueSet/security-labels",
        "bindingName": "SecurityLabels"
      },
      "array": true,
      "index": 4
    },
    "tag": {
      "short": "Tags applied to this resource",
      "type": "Coding",
      "isSummary": true,
      "binding": {
        "strength": "example",
        "valueSet": "http://hl7.org/fhir/ValueSet/common-tags",
        "bindingName": "Tags"
      },
      "array": true,
      "index": 5
    }
  }
}
