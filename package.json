{
  "name": "fhir-zod-gen",
  "version": "0.1.0",
  "description": "Generate Zod schemas (and TypeScript types) from FHIR Implementation Guides, via the FHIR Schema intermediate format.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "fhir-zod-gen": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "lint": "eslint src --ext .ts"
  },
  "keywords": [
    "fhir",
    "zod",
    "typescript",
    "healthcare",
    "codegen",
    "implementation-guide",
    "hl7"
  ],
  "dependencies": {
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "tsx": "^4.16.0",
    "vitest": "^2.0.0",
    "@types/node": "^20.14.0"
  },
  "engines": {
    "node": ">=18"
  }
}
