{
  "name": "fhir-zod-gen",
  "version": "0.1.0",
  "description": "Generate Zod schemas (and TypeScript types) from FHIR Implementation Guides, via the FHIR Schema intermediate format.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "fhir-zod-gen": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "lint": "eslint src",
    "prepublishOnly": "npm run lint && npm run build && npm test"
  },
  "keywords": [
    "fhir",
    "zod",
    "typescript",
    "healthcare",
    "codegen",
    "implementation-guide",
    "hl7"
  ],
  "dependencies": {
    "@atomic-ehr/fhirschema": "^0.0.14",
    "fhir-package-installer": "^1.13.1"
  },
  "peerDependencies": {
    "zod": "^3.25.0 || ^4.0.0"
  },
  "peerDependenciesMeta": {
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.14.0",
    "eslint": "^10.9.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.67.0",
    "vitest": "^2.0.0",
    "zod": "^3.25.0 || ^4.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}
