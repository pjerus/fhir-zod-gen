{
  "name": "fhir-zod-gen",
  "version": "0.1.1",
  "description": "Validate FHIR against US Core, Da Vinci or any published Implementation Guide — generates Zod schemas that enforce profile constraints, not just base R4.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pjerus/fhir-zod-gen.git"
  },
  "homepage": "https://github.com/pjerus/fhir-zod-gen#readme",
  "bugs": {
    "url": "https://github.com/pjerus/fhir-zod-gen/issues"
  },
  "type": "module",
  "bin": {
    "fhir-zod-gen": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "lint": "eslint src",
    "prepublishOnly": "npm run lint && npm run build && npm test"
  },
  "keywords": [
    "fhir",
    "zod",
    "typescript",
    "healthcare",
    "codegen",
    "validation",
    "fhir-profile",
    "us-core",
    "davinci",
    "implementation-guide",
    "structuredefinition",
    "fhir-schema",
    "smart-on-fhir",
    "hl7"
  ],
  "dependencies": {
    "@atomic-ehr/fhirschema": "^0.0.14",
    "fhir-package-installer": "^1.13.1"
  },
  "peerDependencies": {
    "zod": "^3.25.0 || ^4.0.0"
  },
  "peerDependenciesMeta": {
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.14.0",
    "eslint": "^10.9.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.67.0",
    "vitest": "^2.0.0",
    "zod": "^3.25.0 || ^4.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}
